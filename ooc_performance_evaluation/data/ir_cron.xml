<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_performance_cycle_auto_state" model="ir.cron">
        <field name="name">Performance Cycle Auto State Update</field>
        <field name="model_id" ref="model_performance_cycle"/>
        <field name="state">code</field>
        <field name="code">model.cron_auto_update_cycle_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_performance_cycle_reminders" model="ir.cron">
        <field name="name">Performance Cycle Deadline Reminders</field>
        <field name="model_id" ref="model_performance_cycle"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_cycle_deadline_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
