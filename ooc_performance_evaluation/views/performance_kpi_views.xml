<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_performance_kpi_kanban" model="ir.ui.view">
        <field name="name">performance.kpi.kanban</field>
        <field name="model">performance.kpi</field>
        <field name="arch" type="xml">
            <kanban class="o_perf_kpi_kanban">
                <field name="name"/>
                <field name="code"/>
                <field name="cycle_id"/>
                <field name="kpi_level"/>
                <field name="department_id"/>
                <field name="section_id"/>
                <field name="target_value"/>
                <field name="weight"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_perf_card o_perf_kpi_card">
                            <div class="o_perf_card_header">
                                <div>
                                    <div class="o_perf_eyebrow" t-out="record.code.value or record.cycle_id.value"/>
                                    <strong class="o_perf_title" t-out="record.name.value"/>
                                </div>
                                <span class="badge text-bg-secondary" t-out="record.kpi_level.value"/>
                            </div>
                            <div class="o_perf_meta">
                                <span t-out="record.department_id.value or 'Organization'"/>
                                <span t-out="record.section_id.value or record.state.value"/>
                            </div>
                            <div class="o_perf_metric_grid">
                                <div class="o_perf_metric">
                                    <span class="o_perf_metric_value" t-out="record.target_value.value"/>
                                    <span class="o_perf_metric_label">Target</span>
                                </div>
                                <div class="o_perf_metric">
                                    <span class="o_perf_metric_value" t-out="record.weight.value"/>
                                    <span class="o_perf_metric_label">Weight</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_performance_kpi_list" model="ir.ui.view">
        <field name="name">performance.kpi.list</field>
        <field name="model">performance.kpi</field>
        <field name="arch" type="xml">
            <list decoration-info="kpi_level == 'organization'" decoration-primary="kpi_level == 'department'" decoration-success="kpi_level == 'section'" decoration-warning="kpi_level == 'employee'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="code"/>
                <field name="cycle_id"/>
                <field name="kpi_level"/>
                <field name="parent_id"/>
                <field name="department_id"/>
                <field name="section_id"/>
                <field name="target_value"/>
                <field name="weight"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_performance_kpi_form" model="ir.ui.view">
        <field name="name">performance.kpi.form</field>
        <field name="model">performance.kpi</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_lock" string="Lock" type="object" invisible="state == 'locked'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,locked,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_child_kpis" icon="fa-code-fork">
                            <field name="child_count" string="Child KPIs" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_score_sheets" icon="fa-line-chart">
                            <field name="score_sheet_count" string="Score Sheets" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_linked_goals" icon="fa-bullseye">
                            <field name="goal_count" string="Linked Goals" widget="statinfo"/>
                        </button>
                    </div>
                    <group string="KPI Definition">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="cycle_id"/>
                            <field name="kpi_level"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="department_id" invisible="kpi_level not in ('department', 'section', 'employee')"/>
                            <field name="section_id" invisible="kpi_level not in ('section', 'employee')"/>
                            <field name="owner_employee_id" invisible="kpi_level != 'employee'"/>
                            <field name="target_value"/>
                            <field name="measure_unit"/>
                            <field name="weight"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Explain how this KPI is measured and how it cascades to the next level."/>
                    <notebook>
                        <page string="Child KPIs">
                            <field name="child_ids">
                                <list decoration-success="state == 'locked'" decoration-warning="state == 'active'">
                                    <field name="name"/>
                                    <field name="kpi_level"/>
                                    <field name="department_id"/>
                                    <field name="section_id"/>
                                    <field name="target_value"/>
                                    <field name="weight"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Score Sheets">
                            <field name="score_sheet_id" readonly="1">
                                <list>
                                    <field name="cycle_id"/>
                                    <field name="owner_type"/>
                                    <field name="target_value"/>
                                    <field name="actual_value"/>
                                    <field name="achievement_score"/>
                                    <field name="weighted_score"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_performance_kpi_search" model="ir.ui.view">
        <field name="name">performance.kpi.search</field>
        <field name="model">performance.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="cycle_id"/>
                <field name="department_id"/>
                <field name="section_id"/>
                <filter name="filter_org" string="Organization" domain="[('kpi_level', '=', 'organization')]"/>
                <filter name="filter_department" string="Department" domain="[('kpi_level', '=', 'department')]"/>
                <filter name="filter_section" string="Section" domain="[('kpi_level', '=', 'section')]"/>
                <filter name="filter_employee" string="Employee Goal" domain="[('kpi_level', '=', 'employee')]"/>
                <separator/>
                <filter name="group_level" string="Level" context="{'group_by': 'kpi_level'}"/>
                <filter name="group_cycle" string="Cycle" context="{'group_by': 'cycle_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_performance_kpis" model="ir.actions.act_window">
        <field name="name">KPI Structure</field>
        <field name="res_model">performance.kpi</field>
        <field name="view_mode">list,form,pivot,graph,kanban</field>
        <field name="search_view_id" ref="view_performance_kpi_search"/>
    </record>

    <record id="view_performance_kpi_score_kanban" model="ir.ui.view">
        <field name="name">performance.kpi.score.kanban</field>
        <field name="model">performance.kpi.score</field>
        <field name="arch" type="xml">
            <kanban class="o_perf_kpi_score_kanban">
                <field name="cycle_id"/>
                <field name="kpi_id"/>
                <field name="owner_type"/>
                <field name="department_id"/>
                <field name="section_id"/>
                <field name="target_value"/>
                <field name="actual_value"/>
                <field name="achievement_score"/>
                <field name="weighted_score"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_perf_card o_perf_score_card">
                            <div class="o_perf_card_header">
                                <div>
                                    <div class="o_perf_eyebrow" t-out="record.cycle_id.value"/>
                                    <strong class="o_perf_title" t-out="record.kpi_id.value"/>
                                </div>
                                <span class="badge text-bg-secondary" t-out="record.state.value"/>
                            </div>
                            <div class="o_perf_meta">
                                <span t-out="record.owner_type.value"/>
                                <span t-out="record.section_id.value or record.department_id.value or 'Organization'"/>
                            </div>
                            <div class="o_perf_metric_grid">
                                <div class="o_perf_metric">
                                    <span class="o_perf_metric_value" t-out="record.target_value.value"/>
                                    <span class="o_perf_metric_label">Target</span>
                                </div>
                                <div class="o_perf_metric">
                                    <span class="o_perf_metric_value" t-out="record.actual_value.value"/>
                                    <span class="o_perf_metric_label">Actual</span>
                                </div>
                                <div class="o_perf_metric">
                                    <span class="o_perf_metric_value" t-out="record.weighted_score.value"/>
                                    <span class="o_perf_metric_label">Weighted</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_performance_kpi_score_list" model="ir.ui.view">
        <field name="name">performance.kpi.score.list</field>
        <field name="model">performance.kpi.score</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('confirmed', 'locked')" decoration-warning="state == 'submitted'">
                <field name="cycle_id"/>
                <field name="kpi_id"/>
                <field name="owner_type"/>
                <field name="department_id"/>
                <field name="section_id"/>
                <field name="target_value"/>
                <field name="actual_value"/>
                <field name="achievement_score"/>
                <field name="weighted_score"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_performance_kpi_score_form" model="ir.ui.view">
        <field name="name">performance.kpi.score.form</field>
        <field name="model">performance.kpi.score</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_lock" string="Lock" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,confirmed,locked"/>
                </header>
                <sheet>
                    <group string="Score Sheet">
                        <group>
                            <field name="cycle_id"/>
                            <field name="kpi_id"/>
                            <field name="owner_type" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="section_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="target_value"/>
                            <field name="actual_value"/>
                            <field name="weight" readonly="1"/>
                            <field name="achievement_score" readonly="1"/>
                            <field name="weighted_score" readonly="1"/>
                        </group>
                    </group>
                    <field name="remarks" placeholder="Capture assumptions, evidence summary, or exceptions behind the institutional result."/>
                    <field name="evidence_attachment_ids" widget="many2many_binary"/>
                    <group>
                        <field name="confirmed_by" readonly="1"/>
                        <field name="confirmed_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_performance_kpi_score_search" model="ir.ui.view">
        <field name="name">performance.kpi.score.search</field>
        <field name="model">performance.kpi.score</field>
        <field name="arch" type="xml">
            <search>
                <field name="cycle_id"/>
                <field name="kpi_id"/>
                <field name="owner_type"/>
                <filter name="state_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="state_locked" string="Locked" domain="[('state', '=', 'locked')]"/>
                <separator/>
                <filter name="group_owner" string="Owner" context="{'group_by': 'owner_type'}"/>
                <filter name="group_cycle" string="Cycle" context="{'group_by': 'cycle_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_performance_kpi_scores" model="ir.actions.act_window">
        <field name="name">KPI Score Sheet</field>
        <field name="res_model">performance.kpi.score</field>
        <field name="view_mode">list,form,pivot,graph,kanban</field>
        <field name="search_view_id" ref="view_performance_kpi_score_search"/>
    </record>
</odoo>
