<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_performance_evaluation" model="ir.actions.report">
        <field name="name">Employee Evaluation</field>
        <field name="model">performance.evaluation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ooc_performance_evaluation.report_performance_evaluation_document</field>
        <field name="report_file">ooc_performance_evaluation.report_performance_evaluation_document</field>
        <field name="binding_model_id" ref="model_performance_evaluation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_performance_evaluation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Employee Evaluation</h2>
                        <table class="table table-sm o_main_table">
                            <tbody>
                                <tr>
                                    <td><strong>Employee</strong></td>
                                    <td><span t-field="o.employee_id"/></td>
                                    <td><strong>Cycle</strong></td>
                                    <td><span t-field="o.cycle_id"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Category</strong></td>
                                    <td><span t-field="o.evaluation_category"/></td>
                                    <td><strong>Department</strong></td>
                                    <td><span t-field="o.department_id"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Manager</strong></td>
                                    <td><span t-field="o.manager_id"/></td>
                                    <td><strong>Rating</strong></td>
                                    <td><span t-field="o.rating"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Scores</h3>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Individual</th>
                                    <th>Institutional</th>
                                    <th>Goal</th>
                                    <th>Discipline</th>
                                    <th>Events</th>
                                    <th>Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-esc="o.individual_score"/></td>
                                    <td><span t-esc="o.institutional_score"/></td>
                                    <td><span t-esc="o.goal_score"/></td>
                                    <td><span t-esc="o.discipline_score"/></td>
                                    <td><span t-esc="o.events_score"/></td>
                                    <td><span t-esc="o.final_score"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="o.evaluation_category == 'employee'">
                            <h3>Individual Goals</h3>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Goal</th>
                                        <th>Target</th>
                                        <th>Actual</th>
                                        <th>Achievement</th>
                                        <th>Weight</th>
                                        <th>Weighted Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.line_ids" t-as="line">
                                        <td><span t-field="line.goal_id"/></td>
                                        <td><span t-esc="line.target_value"/></td>
                                        <td><span t-esc="line.actual_value"/></td>
                                        <td><span t-esc="line.achievement_score"/></td>
                                        <td><span t-esc="line.weight"/></td>
                                        <td><span t-esc="line.weighted_score"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <h3>Comments</h3>
                        <p><strong>Manager:</strong> <span t-esc="o.manager_comment or ''"/></p>
                        <p><strong>HR:</strong> <span t-esc="o.hr_comment or ''"/></p>
                        <p><strong>Reward:</strong> <span t-esc="o.reward_rule_id.reward_description if o.reward_rule_id else ''"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
