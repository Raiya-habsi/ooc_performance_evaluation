            <field name="model_id" ref="model_performance_goal"/>
            <field name="groups" eval="[(4, ref('group_performance_section_head'))]"/>
            <field name="domain_force">['|', ('section_id.manager_id.user_id', '=', user.id), ('department_id.manager_id.user_id', '=', user.id)]</field>
