            <field name="groups" eval="[(4, ref('group_performance_section_head'))]"/>
            <field name="domain_force">[('employee_id.evaluation_section_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_goal_employee" model="ir.rule">
            <field name="name">Goal Bank - Employee Department</field>
            <field name="model_id" ref="model_performance_goal"/>
            <field name="groups" eval="[(4, ref('group_performance_employee'))]"/>
            <field name="domain_force">['|', ('department_id', '=', user.employee_id.department_id.id), ('section_id', '=', user.employee_id.department_id.id)]</field>
        </record>

        <record id="rule_performance_goal_manager" model="ir.rule">
            <field name="name">Goal Bank - Manager Own</field>
            <field name="model_id" ref="model_performance_goal"/>
            <field name="groups" eval="[(4, ref('group_performance_direct_manager'))]"/>
