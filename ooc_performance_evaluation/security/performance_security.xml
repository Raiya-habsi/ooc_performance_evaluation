        <record id="rule_performance_kpi_executive_read_all" model="ir.rule">
            <field name="name">KPI - Executive Read All</field>
            <field name="model_id" ref="model_performance_kpi"/>
            <field name="groups" eval="[(4, ref('group_performance_executive_viewer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
