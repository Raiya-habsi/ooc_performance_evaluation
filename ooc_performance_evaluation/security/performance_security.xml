<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_performance_evaluation" model="ir.module.category">
            <field name="name">Performance Evaluation</field>
            <field name="description">Access rights for OOC performance evaluation.</field>
            <field name="sequence">35</field>
        </record>

        <record id="res_groups_privilege_performance_evaluation" model="res.groups.privilege">
            <field name="name">Performance Evaluation</field>
            <field name="description">Access level for the OOC performance evaluation module.</field>
            <field name="placeholder">No Access</field>
            <field name="sequence">80</field>
            <field name="category_id" ref="module_category_performance_evaluation"/>
        </record>

        <record id="group_performance_employee" model="res.groups">
            <field name="name">Performance / Employee</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_performance_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_performance_direct_manager" model="res.groups">
            <field name="name">Performance / Direct Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_performance_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_performance_employee'))]"/>
        </record>

        <record id="group_performance_section_head" model="res.groups">
            <field name="name">Performance / Section Head</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_performance_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_performance_employee'))]"/>
        </record>

        <record id="group_performance_hr_officer" model="res.groups">
            <field name="name">Performance / HR Officer</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_performance_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_performance_hr_manager" model="res.groups">
            <field name="name">Performance / HR Manager</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="res_groups_privilege_performance_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_performance_hr_officer'))]"/>
        </record>

        <record id="group_performance_executive_viewer" model="res.groups">
            <field name="name">Performance / Executive Viewer</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="res_groups_privilege_performance_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_performance_administrator" model="res.groups">
            <field name="name">Performance / Administrator</field>
            <field name="sequence">70</field>
            <field name="privilege_id" ref="res_groups_privilege_performance_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_system')), (4, ref('group_performance_hr_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_performance_goal_selection_employee" model="ir.rule">
            <field name="name">Goal Selection - Employee Own</field>
            <field name="model_id" ref="model_performance_goal_selection"/>
            <field name="groups" eval="[(4, ref('group_performance_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_goal_selection_manager" model="ir.rule">
            <field name="name">Goal Selection - Direct Manager</field>
            <field name="model_id" ref="model_performance_goal_selection"/>
            <field name="groups" eval="[(4, ref('group_performance_direct_manager'))]"/>
            <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_goal_selection_section_head" model="ir.rule">
            <field name="name">Goal Selection - Section Head</field>
            <field name="model_id" ref="model_performance_goal_selection"/>
            <field name="groups" eval="[(4, ref('group_performance_section_head'))]"/>
            <field name="domain_force">[('employee_id.evaluation_section_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_evaluation_employee" model="ir.rule">
            <field name="name">Evaluation - Employee Own</field>
            <field name="model_id" ref="model_performance_evaluation"/>
            <field name="groups" eval="[(4, ref('group_performance_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_evaluation_manager" model="ir.rule">
            <field name="name">Evaluation - Direct Manager</field>
            <field name="model_id" ref="model_performance_evaluation"/>
            <field name="groups" eval="[(4, ref('group_performance_direct_manager'))]"/>
            <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_evaluation_section_head" model="ir.rule">
            <field name="name">Evaluation - Section Head</field>
            <field name="model_id" ref="model_performance_evaluation"/>
            <field name="groups" eval="[(4, ref('group_performance_section_head'))]"/>
            <field name="domain_force">[('employee_id.evaluation_section_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_evaluation_hr_officer_all" model="ir.rule">
            <field name="name">Evaluation - HR Officer Full Access</field>
            <field name="model_id" ref="model_performance_evaluation"/>
            <field name="groups" eval="[(4, ref('group_performance_hr_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_performance_evaluation_hr_manager_all" model="ir.rule">
            <field name="name">Evaluation - HR Manager Full Access</field>
            <field name="model_id" ref="model_performance_evaluation"/>
            <field name="groups" eval="[(4, ref('group_performance_hr_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_performance_evaluation_admin_all" model="ir.rule">
            <field name="name">Evaluation - Administrator Full Access</field>
            <field name="model_id" ref="model_performance_evaluation"/>
            <field name="groups" eval="[(4, ref('group_performance_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_performance_discipline_employee" model="ir.rule">
            <field name="name">Discipline - Employee Own</field>
            <field name="model_id" ref="model_performance_discipline_score"/>
            <field name="groups" eval="[(4, ref('group_performance_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_discipline_manager" model="ir.rule">
            <field name="name">Discipline - Direct Manager</field>
            <field name="model_id" ref="model_performance_discipline_score"/>
            <field name="groups" eval="[(4, ref('group_performance_direct_manager'))]"/>
            <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
