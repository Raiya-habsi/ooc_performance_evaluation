            <field name="model_id" ref="model_performance_event_participation"/>
            <field name="groups" eval="[(4, ref('group_performance_section_head'))]"/>
            <field name="domain_force">[('employee_id.evaluation_section_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_appeal_employee" model="ir.rule">
            <field name="name">Appeal - Employee Own</field>
            <field name="model_id" ref="model_performance_appeal"/>
            <field name="groups" eval="[(4, ref('group_performance_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_appeal_manager" model="ir.rule">
            <field name="name">Appeal - Direct Manager</field>
            <field name="model_id" ref="model_performance_appeal"/>
            <field name="groups" eval="[(4, ref('group_performance_direct_manager'))]"/>
            <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_appeal_section_head" model="ir.rule">
            <field name="name">Appeal - Section Head</field>
            <field name="model_id" ref="model_performance_appeal"/>
            <field name="groups" eval="[(4, ref('group_performance_section_head'))]"/>
            <field name="domain_force">[('employee_id.evaluation_section_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_dev_plan_employee" model="ir.rule">
            <field name="name">Development Plan - Employee Own</field>
            <field name="model_id" ref="model_performance_development_plan"/>
