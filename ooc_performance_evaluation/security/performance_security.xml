            <field name="model_id" ref="model_performance_midyear_review"/>
            <field name="groups" eval="[(4, ref('group_performance_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_midyear_manager" model="ir.rule">
            <field name="name">Mid-Year Review - Direct Manager</field>
            <field name="model_id" ref="model_performance_midyear_review"/>
            <field name="groups" eval="[(4, ref('group_performance_direct_manager'))]"/>
            <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_performance_midyear_section_head" model="ir.rule">
